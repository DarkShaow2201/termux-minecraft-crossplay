# Network settings for this server.
#
# Recommended: leave BIND_IP empty so the server works on Wi-Fi, hotspot, and
# Playit without binding to an address that Android may change.
BIND_IP=

# Example only. Replace this with the phone's actual LAN IP if needed.
# A router DHCP reservation can keep 192.168.1.100 assigned to the phone.
ADVERTISE_IP=192.168.1.100

JAVA_PORT=25565
BEDROCK_PORT=19132